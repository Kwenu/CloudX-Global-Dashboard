# Public (browser-safe) Supabase settings. Set these in Vercel → Project → Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service-role key in a VITE_ variable. It is only used by the
# Supabase Edge Function (set with `supabase secrets set`), see supabase/README.md.
